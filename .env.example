# Telegram
BOT_TOKEN=123456:replace_me
ALLOWED_USER_ID=111111111
ADMIN_USER_ID=222222222

# PostgreSQL (Docker Compose defaults work as-is)
POSTGRES_DB=sohu_observer
POSTGRES_USER=sohu
POSTGRES_PASSWORD=
# Для Docker Compose DATABASE_URL формируется автоматически.
# Для локального запуска без Compose задайте полный postgresql:// URL.
DATABASE_URL=

# SohuPro
SOHU_BASE_URL=https://weidubot.cc/api/v2
SOHU_API_KEY=replace_me
SOHU_API_SECRET=replace_me
SOHU_INITIAL_CREDIT_TRX=20
SOHU_CREDIT_RESERVE_ORDERS=2
SOHU_CREDIT_TOPUP_TRX=20
SOHU_NET_PROTECT=open
SOHU_POLL_INTERVAL_SECONDS=90
SOHU_REQUEST_TIMEOUT_MS=20000

# Product rules
INITIAL_USER_BALANCE_TRX=100
SERVICE_FEE_TRX=0.3
PRO_DEPOSIT_TRX=15
PRO_MIN_ENERGY_72H=460000

# Runtime
PORT=3000
LOG_LEVEL=info
